# Создаем файл-пример для других разработчиков
@"
# Django
SECRET_KEY=django-insecure-key-for-dev
DEBUG=True

# PostgreSQL
DB_NAME=diary_db
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432

# Redis
REDIS_URL=redis://localhost:6379/0

# Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
"@ | Out-File -FilePath ".env.example" -Encoding UTF8 -Force
